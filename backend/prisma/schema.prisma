generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  name        String
  prodi       String?
  semester    Int?     @default(1)
  email       String?  @unique
  phone       String?
  bio         String?
  avatarColor String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  todos        Todo[]
  notes        Note[]
  schedules    Schedule[]
  materials    Material[]
  quizAttempts QuizAttempt[]
}

model Todo {
  id        String    @id @default(uuid())
  userId    String
  title     String
  subject   String?
  deadline  DateTime?
  priority  String    @default("medium") // high, medium, low
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id        String  @id @default(uuid())
  userId    String
  subject   String
  day       String
  startTime String
  endTime   String
  room      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Material {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  fileUrl    String?
  subject    String?
  uploadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id           String  @id @default(uuid())
  subject      String
  question     String
  options      Json // Array of strings
  correctIndex Int
  explanation  String?
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  score          Int
  totalQuestions Int
  takenAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
